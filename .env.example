# PostgreSQL
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=postgres_db_name
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# FastAPI
API_PORT=8000

# Optional single-user login. Generate APP_SECRET_KEY with: openssl rand -hex 32
AUTH_ENABLED=false
APP_ADMIN_PASSWORD=
APP_SECRET_KEY=
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=24

# Dedicated encryption passphrase for model API keys. Generate with: openssl rand -hex 32
MODEL_CREDENTIAL_KEY=
INTERNAL_SERVICE_TOKEN=change-this-for-public-deployments

# Web entrypoint (Nginx)
WEB_PORT=3000

# Model proxy security. Set to false on public deployments unless private models are required.
ALLOW_PRIVATE_MODEL_HOSTS=true
API_RATE_LIMIT_PER_MINUTE=120
